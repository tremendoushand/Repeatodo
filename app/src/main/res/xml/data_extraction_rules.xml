<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- device.db holds calendar event ids that only mean something on this phone. -->
    <cloud-backup>
        <include domain="database" path="." />
        <exclude domain="database" path="device.db" />
        <exclude domain="database" path="device.db-shm" />
        <exclude domain="database" path="device.db-wal" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="database" path="device.db" />
        <exclude domain="database" path="device.db-shm" />
        <exclude domain="database" path="device.db-wal" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
